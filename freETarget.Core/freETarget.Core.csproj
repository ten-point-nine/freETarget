<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- namespaces stay "freETarget.*": events are stored in the database with the full type name of their target class -->
    <RootNamespace>freETarget</RootNamespace>
    <AssemblyName>freETarget.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="System.IO.Ports" Version="10.0.*" />
    <!-- the platform independent build. not the -GDI or -WPF ones, which only work on Windows -->
    <PackageReference Include="PDFsharp" Version="6.2.*" />
    <!-- same version as Avalonia.Skia uses, the desktop application draws with both -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="freETarget.Tests" />
    <InternalsVisibleTo Include="freETarget.Desktop" />
    <InternalsVisibleTo Include="freETarget.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- template database, copied next to the executable of every application that references this library -->
    <Content Include="Storage.db" CopyToOutputDirectory="PreserveNewest" />
    <!-- logo for the footer of the PDF reports -->
    <EmbeddedResource Include="logo.png" LogicalName="freETarget.logo.png" />
  </ItemGroup>

</Project>
